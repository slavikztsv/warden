# Copy to .env and fill in.  .env is gitignored and never enters an image.
#
# Compose reads a root .env for ${VAR} interpolation in docker-compose.yml.
# That is NOT the same as passing a variable into a container — only services
# that explicitly declare it in `environment:` receive it.  GEMINI_API_KEY is
# declared on agent-runtime alone: the broker enforces policy and has no
# business holding a model credential.

# Required for `--live`.  Without it the agent replays agent/cassettes/*.json,
# which is the default and what the demo uses.
GEMINI_API_KEY=

# Optional.  Leave blank to let the runtime pick a model your key can reach.
GEMINI_MODEL=

# Set by scripts/demo.sh at run time.  Declared here only so Compose stops
# warning that it is unset on every invocation.
TASK_TOKEN=
