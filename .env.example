# Copy to .env and fill in.  .env is gitignored and never enters an image.
#
# Compose reads a root .env for ${VAR} interpolation in docker-compose.yml.
# That is NOT the same as passing a variable into a container — only services
# that explicitly declare it in `environment:` receive it.  GEMINI_API_KEY is
# declared on agent-runtime alone: the broker enforces policy and has no
# business holding a model credential.

# ONE of the two below is required for `--live`.  Without either of them the
# agent replays agent/cassettes/*.json, which is the default and what the demo
# uses.  Precedence when both are set: openrouter, then gemini -- or set
# WARDEN_PROVIDER to settle it outright.  Every run prints the provider and
# model it actually used, so this is never a guess.

# OpenRouter reaches many vendors with one key and needs NO extra package:
# it speaks the OpenAI HTTP shape, and httpx is already a dependency.  This is
# the easiest way to run the same scenario across several models -- see
# docs/live-enforcement-2026-07-30.md for why that is worth doing.
OPENROUTER_API_KEY=
# Vendor-qualified id from https://openrouter.ai/models, e.g.
# openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, google/gemini-2.5-flash.
# Blank uses the tested default.  The model must support tool calling.
OPENROUTER_MODEL=

# Needs `pip install -r requirements-live.txt`.
GEMINI_API_KEY=

# Optional.  Leave blank to let the runtime pick a model your key can reach.
GEMINI_MODEL=

# Optional.  openrouter | gemini.  Overrides the precedence above.
WARDEN_PROVIDER=

# Set by scripts/demo.sh at run time.  Declared here only so Compose stops
# warning that it is unset on every invocation.
TASK_TOKEN=
